# ============================================================
# ENSO Monitor - Variables d'environnement
# Copier ce fichier en .env et remplir les vraies valeurs
# Ne jamais committer le fichier .env sur Git
# ============================================================

# Mode debug (True en développement, False en production)
DEBUG=True

# URL de connexion PostgreSQL
# Format : postgresql://utilisateur:motdepasse@hote:port/nom_base
DATABASE_URL=postgresql://enso_user:enso_password@localhost:5432/enso_monitor
